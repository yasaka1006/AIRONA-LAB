# Cloudflare Pages / wrangler pages dev 用（Secrets のローカル相当）
# このファイルをコピー: cp .dev.vars.example .dev.vars
# .dev.vars は git に入れない

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
RESEND_API_KEY=re_xxx
# 検証済みドメイン推奨。テストのみなら onboarding@resend.dev
MAIL_FROM=TABbeast <noreply@example.com>
APP_BASE_URL=http://127.0.0.1:8788
SESSION_SECRET=change-me-to-a-long-random-string
# Better Auth（未設定時は SESSION_SECRET を流用）
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Google OAuth（未設定ならマイページはマジックリンクのみ）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DOWNLOAD_URL_TTL_SEC=3600
MAGIC_LINK_TTL_SEC=900
DEMO_WEB_URL=https://tabbeast-demo.pages.dev
# DEMO Windows の公開 DL URL（未設定ならボタンは準備中表示）
DEMO_WIN_URL=

# P1 ローカル確認用（本番では付けない）
# Stripe 未設定時、同意＋ログインで権利を付与してマイページへ（本番禁止）
COMMERCE_DEV_FAKE_CHECKOUT=1
# R2 に実ファイルが無いとき、小さなプレースホルダ zip を返す
COMMERCE_DEV_FAKE_DOWNLOAD=1
# R2 に full_web が無いとき、ゲート通過後にプレースホルダ HTML を返す
COMMERCE_DEV_FAKE_APP=1
