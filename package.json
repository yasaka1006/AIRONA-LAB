{
  "name": "tokyo-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8788 --show-interactive-dev-session=false --inspector-port=0",
    "db:commerce:local": "wrangler d1 execute airona-commerce --local --file=./migrations/commerce/001_init.sql",
    "db:commerce:remote": "wrangler d1 execute airona-commerce --remote --file=./migrations/commerce/001_init.sql",
    "db:commerce:seed:local": "wrangler d1 execute airona-commerce --local --file=./migrations/commerce/002_seed_releases.sql",
    "db:commerce:seed:remote": "wrangler d1 execute airona-commerce --remote --file=./migrations/commerce/002_seed_releases.sql",
    "r2:placeholder:local": "wrangler r2 object put tabbeast-products/tabbeast/full/win/0.1.0/TABbeast_0.1.0_x64.zip --file=./fixtures/TABbeast_0.1.0_x64.placeholder.zip --local",
    "r2:placeholder:remote": "wrangler r2 object put tabbeast-products/tabbeast/full/win/0.1.0/TABbeast_0.1.0_x64.zip --file=./fixtures/TABbeast_0.1.0_x64.placeholder.zip --remote",
    "r2:web:placeholder:remote": "wrangler r2 object put tabbeast-products/tabbeast/full/web/0.1.0/index.html --file=./fixtures/full_web/0.1.0/index.html --content-type=text/html --remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "canvas-confetti": "^1.9.4",
    "confetti": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wrangler": "^4.125.0"
  }
}
